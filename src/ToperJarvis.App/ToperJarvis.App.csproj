<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- net10.0-windows: v1 celuje w Windows (tray, NAudio, Platform.Windows) -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
  </PropertyGroup>

  <ItemGroup>
    <Folder Include="Models\" />
    <AvaloniaResource Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.0.4" />
    <PackageReference Include="Avalonia.Desktop" Version="12.0.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.4" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.1">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.1" />
    <PackageReference Include="OpenCvSharp4.Windows" Version="4.10.0.20241108" />
    <PackageReference Include="Markdown.Avalonia.Tight" Version="12.0.0-a3" />
    <!-- Microsoft.Extensions.Hosting jest dostarczany przez FrameworkReference Microsoft.AspNetCore.App
         (poniżej) — jawny PackageReference był redundantny i powodował ostrzeżenie NU1510. -->
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
    <PackageReference Include="SkiaSharp" Version="3.119.4" />
    <PackageReference Include="System.Diagnostics.PerformanceCounter" Version="10.0.9" />
  </ItemGroup>

  <!-- Serwer MCP wystawiający lokalne narzędzia agentowi Hermes (Hektor) — wymaga ASP.NET Core. -->
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <None Update="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
    <None Update="appsettings.Local.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('appsettings.Local.json')" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\ToperJarvis.Core\ToperJarvis.Core.csproj" />
    <ProjectReference Include="..\ToperJarvis.Platform.Windows\ToperJarvis.Platform.Windows.csproj" />
    <ProjectReference Include="..\ToperJarvis.Abstractions\ToperJarvis.Abstractions.csproj" />
  </ItemGroup>

  <!--
    Kompletna publikacja: po opublikowaniu kopiuje katalog assets/ (modele Whisper/Piper/Smart Turn/
    Silero — trzymane poza wynikiem kompilacji) obok pliku wykonywalnego. Działa dla publikacji z
    Visual Studio (profil FolderProfile.pubxml) oraz `dotnet publish` / scripts/publish.ps1.
    Czyszczenie katalogu robi profil (DeleteExistingFiles).

    appsettings.Local.json (klucz API Hermesa, token MCP, HA, kamera) jest DOŁĄCZANY do publikacji
    przez CopyToOutputDirectory — bez niego opublikowana apka nie połączy się z Hektorem (401) ani
    nie użyje właściwego modelu STT. To build LOKALNY (katalog publish/ jest gitignore'owany).
    UWAGA: przy dystrybucji na INNĄ maszynę usuń stamtąd appsettings.Local.json (zawiera sekrety)
    lub dostarcz docelowej maszynie własny.
  -->
  <Target Name="PrepareCompletePublish" AfterTargets="Publish">
    <PropertyGroup>
      <_JarvisAssetsDir>$(MSBuildProjectDirectory)\..\..\assets</_JarvisAssetsDir>
    </PropertyGroup>
    <ItemGroup>
      <_JarvisAsset Include="$(_JarvisAssetsDir)\**\*" />
    </ItemGroup>
    <Copy Condition="Exists('$(_JarvisAssetsDir)')"
          SourceFiles="@(_JarvisAsset)"
          DestinationFiles="@(_JarvisAsset->'$(PublishDir)assets\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Warning Condition="!Exists('$(_JarvisAssetsDir)')"
             Text="Brak katalogu assets/ — modele nie zostaly skopiowane do publikacji (zob. assets/SETUP.md)." />
    <Message Importance="high" Text="Kompletny build: assets/ w $(PublishDir)assets, appsettings.Local.json dolaczony (build lokalny)." />
  </Target>
</Project>
